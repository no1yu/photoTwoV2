page {
  height: 100%;
  overflow: hidden;
  background: #111;
}

.camera {
  position: relative;
  box-sizing: border-box;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #111;
}

.camera::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 300rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.66));
  pointer-events: none;
}

.contain-photo {
  width: 100%;
  height: 100%;
}

image {
  width: 100%;
  height: 100%;
}

.person {
  position: absolute;
  left: 0;
  right: 0;
  top: 14vh;
  pointer-events: none;
  bottom: calc(264rpx + env(safe-area-inset-bottom));
}

.person image {
  width: 100%;
  height: 100%;
  opacity: 0.72;
}

.icon_cameraC,
.icon_cameraT,
.icon_back,
.icon_confirm {
  position: absolute;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  border-radius: 50%;
}

.icon_cameraC {
  width: 152rpx;
  height: 152rpx;
  left: 50%;
  bottom: calc(90rpx + env(safe-area-inset-bottom));
  margin-left: -76rpx;
}

.icon_cameraT {
  width: 104rpx;
  height: 104rpx;
  right: 62rpx;
  bottom: calc(114rpx + env(safe-area-inset-bottom));
}

.icon_back {
  width: 104rpx;
  height: 104rpx;
  left: 62rpx;
  bottom: calc(114rpx + env(safe-area-inset-bottom));
}

.icon_confirm {
  width: 104rpx;
  height: 104rpx;
  right: 62rpx;
  bottom: calc(114rpx + env(safe-area-inset-bottom));
}

.camera-header {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  z-index: 3;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.5), transparent);
}


.control-label {
  position: absolute;
  top: calc(100% + 34rpx);
  left: 50%;
  transform: translateX(-50%);
  color: #fff;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.icon_cameraC .control-label {
  top: calc(100% + 10rpx);
}

.confirm-actions .icon_back,
.confirm-actions .icon_confirm {
  box-sizing: border-box;
  padding: 16rpx;
  background: rgba(0, 0, 0, 0.3);
}

