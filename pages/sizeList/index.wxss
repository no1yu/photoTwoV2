page {
  height: 100vh;
  overflow: hidden;
}

.size-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
}

page-header {
  flex-shrink: 0;
}

.search-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 80rpx;
  margin: 28rpx 28rpx 16rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #8A8E96;
  font-size: 28rpx;
}

.search-bar text {
  margin-left: 16rpx;
}

.tabs-wrap {
  flex-shrink: 0;
  margin: 0 28rpx 20rpx;
  --tabs-nav-background-color: transparent;
  --tabs-line-height: 76rpx;
}

.category-wrap {
  height: 76rpx !important;
}

.category-nav {
  padding: 0 !important;
  background: transparent !important;
}

.category-tab {
  height: 76rpx;
  padding: 0 4rpx !important;
  font-size: 28rpx !important;
  font-weight: 400;
  line-height: 76rpx !important;
}

.category-active {
  font-weight: 500;
}

.container {
  flex: 1;
  height: 0;
  min-height: 0;
}

.grid-container {
  padding: 0 28rpx;
}

.grid-item {
  display: flex;
  align-items: center;
  min-height: 138rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
}

.grid-content {
  flex: 1;
  min-width: 0;
}

.title {
  color: #30343B;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.4;
}

.description {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
}

.description text {
  flex: 1;
  min-width: 0;
}

.arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.scroll-to-top {
  position: fixed;
  right: 28rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid #E9EBEF;
  border-radius: 50%;
  background: #fff;
}

.custom-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 28rpx;
}

.custom-empty-title {
  margin-top: 24rpx;
  color: #8A8E96;
  font-size: 28rpx;
  font-weight: 400;
}

.custom-empty-desc {
  margin-top: 12rpx;
  color: #8A8E96;
  font-size: 26rpx;
}

.list-status {
  padding: 8rpx 28rpx 22rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}
