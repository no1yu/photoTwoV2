<view class="size-page page-shell">
  <page-header title="规格列表" light="{{true}}" />

  <view class="search-bar" bindtap="navigateTo">
    <van-icon name="search" size="38rpx" color="#8A8E96" />
    <text>搜索规格名称、尺寸</text>
  </view>

  <view class="tabs-wrap">
    <van-tabs active="{{active}}" use-before-change="{{true}}" bind:before-change="beforeTabChange" bind:click="clickTab" color="#3D68ED" title-active-color="#30343B" title-inactive-color="#8A8E96" nav-class="category-nav" tab-class="category-tab" tab-active-class="category-active" wrap-class="category-wrap" line-height="4rpx" line-width="44rpx">
      <van-tab title="常用尺寸" name="1"></van-tab>
      <van-tab title="各类证件" name="3"></van-tab>
      <van-tab title="各类签证" name="2"></van-tab>
      <van-tab title="我的定制" name="4"></van-tab>
    </van-tabs>
  </view>

  <scroll-view class="container" scroll-y bindscrolltolower="moredata" bindscroll="onPageScroll" scroll-top="{{scrollTop}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view class="grid-container">
      <view class="grid-item" wx:for="{{photoSizeList}}" wx:key="id" data-index="{{index}}" bindtap="goNextPage">
        <view class="grid-content">
          <view class="title">{{item.name}}</view>
          <view class="description"><text>{{item.widthMm}} × {{item.heightMm}} mm</text><text>{{item.widthPx}} × {{item.heightPx}} px</text></view>
        </view>
        <view class="arrow"><van-icon name="arrow" size="28rpx" color="#B7BAC1" /></view>
      </view>
    </view>
    <view class="list-status" wx:if="{{loadingMore && !photoSizeList.length}}">加载中...</view>
    <view class="custom-empty" wx:if="{{!loadingMore && !photoSizeList.length && !hasMoreData}}">
      <van-icon name="records" size="96rpx" color="#B8C6E8" />
      <text class="custom-empty-title">{{category == 4 ? '暂无定制尺寸' : '暂无规格'}}</text>
      <text class="custom-empty-desc" wx:if="{{category == 4}}">你保存的定制规格会显示在这里</text>
    </view>
    <view class="list-status" wx:if="{{photoSizeList.length}}">
      <text wx:if="{{loadingMore}}">正在加载更多...</text>
      <text wx:elif="{{hasMoreData}}">上拉加载更多</text>
    </view>
  </scroll-view>

  <view class="scroll-to-top" wx:if="{{showBackTop}}" bindtap="scrollToTop">
    <van-icon name="arrow-up" size="36rpx" color="#3D68ED" />
  </view>
</view>
