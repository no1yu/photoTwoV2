.home-page {
  min-height: 100vh;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  background: #F5F6F8;
}

.home-content {
  padding: 28rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #8A8E96;
  font-size: 28rpx;
}

.search-bar text {
  margin-left: 16rpx;
}

.hero {
  position: relative;
  height: 354rpx;
  margin-top: 20rpx;
  padding: 38rpx 28rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #3D68ED;
}

.hero-content {
  position: relative;
  z-index: 2;
  width: 300rpx;
}

.hero-title {
  display: block;
  color: #fff;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.32;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  line-height: 1.5;
}

.hero-button {
  width: 214rpx;
  height: 88rpx;
  margin: 22rpx 0 0;
  border-radius: 44rpx;
  background: #fff;
  color: #3D68ED;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 88rpx;
}

.hero-photos {
  position: absolute;
  top: 34rpx;
  right: 26rpx;
  width: 306rpx;
  height: 292rpx;
}

.photo-frame {
  position: absolute;
  padding: 7rpx;
  background: #fff;
  overflow: hidden;
  border-radius: 6rpx;
  box-shadow: 0 8rpx 18rpx rgba(26, 68, 165, 0.14);
}

.photo-frame image {
  width: 100%;
  height: 100%;
  background: #fff;
}

.photo-front image {
  background: #438EDB;
}

.photo-front {
  left: 6rpx;
  top: 0;
  z-index: 1;
  width: 194rpx;
  height: 274rpx;
  transform: rotate(-5deg);
}

.photo-back {
  right: 0;
  top: 34rpx;
  width: 164rpx;
  height: 244rpx;
  transform: rotate(10deg);
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 164rpx;
  border-radius: 20rpx;
  background: #fff;
}

.quick-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.quick-label {
  margin-top: 16rpx;
  color: #30343B;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.4;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 20rpx;
}

.section-title {
  color: #30343B;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.4;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8A8E96;
  font-size: 26rpx;
}

.size-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.size-card {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 158rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
}

.size-copy {
  flex: 1;
  min-width: 0;
}

.size-title {
  display: block;
  overflow: hidden;
  margin-bottom: 12rpx;
  color: #30343B;
  font-size: 32rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.size-detail {
  display: block;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
}
