.admin-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #fff;
}

.admin-content {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx calc(80rpx + env(safe-area-inset-bottom));
}

.auth-panel {
  width: 100%;
  max-width: 560rpx;
  text-align: center;
}

.device-scene {
  position: relative;
  width: 392rpx;
  height: 256rpx;
  margin: 0 auto 44rpx;
}

.desktop-window {
  position: absolute;
  top: 14rpx;
  left: 22rpx;
  width: 280rpx;
  height: 184rpx;
  overflow: hidden;
  border: 4rpx solid #71809B;
  border-radius: 12rpx;
  background: #fff;
}

.desktop-toolbar {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 24rpx;
  padding: 0 10rpx;
  border-bottom: 2rpx solid #E4E8F0;
  background: #F4F6FA;
}

.window-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #AAB6CB;
}

.desktop-body {
  display: flex;
  height: 152rpx;
}

.desktop-sidebar {
  width: 52rpx;
  padding: 20rpx 10rpx;
  border-right: 2rpx solid #E7EBF3;
  background: #F8FAFD;
}

.sidebar-line {
  height: 6rpx;
  margin-bottom: 12rpx;
  border-radius: 3rpx;
  background: #DCE3EF;
}

.sidebar-line.active {
  background: #91ACED;
}

.desktop-workspace {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.desktop-photo {
  position: relative;
  width: 52rpx;
  height: 64rpx;
  border: 2rpx solid #8AA8EF;
  border-radius: 4rpx;
  background: #F0F4FF;
}

.desktop-photo::before {
  position: absolute;
  top: 10rpx;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8AA8EF;
  transform: translateX(-50%);
  content: '';
}

.desktop-photo::after {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 28rpx;
  height: 16rpx;
  border-radius: 14rpx 14rpx 3rpx 3rpx;
  background: #8AA8EF;
  transform: translateX(-50%);
  content: '';
}

.workspace-line {
  width: 52rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #DEE5F1;
}

.desktop-stand {
  position: absolute;
  top: 198rpx;
  left: 108rpx;
  width: 108rpx;
  height: 28rpx;
  border-bottom: 4rpx solid #71809B;
  border-radius: 2rpx;
}

.desktop-stand::before {
  position: absolute;
  top: 0;
  left: 44rpx;
  width: 20rpx;
  height: 24rpx;
  background: #71809B;
  content: '';
}

.phone-window {
  position: absolute;
  top: 86rpx;
  right: 14rpx;
  width: 86rpx;
  height: 148rpx;
  border: 4rpx solid #3D68ED;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(46, 78, 145, 0.08);
}

.phone-speaker {
  width: 22rpx;
  height: 4rpx;
  margin: 10rpx auto 14rpx;
  border-radius: 2rpx;
  background: #91A5CB;
}

.phone-avatar {
  width: 28rpx;
  height: 28rpx;
  margin: 0 auto 12rpx;
  border: 3rpx solid #A5BAEF;
  border-radius: 50%;
  background: #EDF2FF;
}

.phone-line {
  width: 42rpx;
  height: 5rpx;
  margin: 0 auto 7rpx;
  border-radius: 3rpx;
  background: #DEE5F1;
}

.phone-line.short {
  width: 28rpx;
}

.phone-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  width: 56rpx;
  height: 20rpx;
  margin: 14rpx auto 0;
  border-radius: 5rpx;
  background: #3D68ED;
}

.phone-dot {
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: #fff;
}

.phone-check {
  width: 12rpx;
  height: 7rpx;
  margin-top: -3rpx;
  border-bottom: 2rpx solid #fff;
  border-left: 2rpx solid #fff;
  transform: rotate(-45deg);
}

.auth-title {
  display: block;
  color: #30343B;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1.45;
}

.auth-note {
  display: block;
  margin-top: 18rpx;
  color: #9A9FA8;
  font-size: 24rpx;
  line-height: 1.6;
}

.auth-actions {
  min-height: 172rpx;
  margin-top: 56rpx;
}

.authorize-button,
.return-button {
  width: 100%;
  height: 88rpx;
  margin: 0;
  font-size: 30rpx;
  line-height: 88rpx;
}

.cancel-button {
  width: 100%;
  height: 72rpx;
  margin: 12rpx 0 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #8A8E96;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 72rpx;
}

.cancel-button:active {
  color: #3D68ED;
}

.cancel-button[disabled] {
  background: transparent;
  color: #B3B6BC;
}
