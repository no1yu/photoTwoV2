<view class="feedback-page page-shell">
  <page-header title="意见反馈" back="{{true}}" light="{{true}}" />
  <view class="feedback-content">
    <view class="feedback-intro">
      <text class="intro-desc">使用问题或功能建议，都可以在这里告诉我们</text>
    </view>

    <view class="form-card">
      <view class="form-section">
        <view class="section-title">反馈类型</view>
        <view class="type-grid">
          <view class="type-item {{type == item.value ? 'active' : ''}}" wx:for="{{typeList}}" wx:key="value" data-value="{{item.value}}" bindtap="selectType">{{item.name}}</view>
        </view>
      </view>

      <view class="form-section">
        <view class="section-title">反馈内容</view>
        <view class="textarea-box {{focusedInput == 'content' ? 'focused' : ''}}">
          <textarea value="{{content}}" maxlength="300" placeholder="请详细描述你的建议或遇到的问题，至少10个字" placeholder-class="input-placeholder" data-field="content" bindinput="changeContent" bindfocus="onInputFocus" bindblur="onInputBlur"></textarea>
          <text class="word-count">{{content.length}}/300</text>
        </view>
      </view>

      <view class="form-section">
        <view class="section-head"><text class="section-title">上传图片</text><text class="section-note">选填</text></view>
        <view class="image-area">
          <view class="image-item" wx:if="{{image}}">
            <image src="{{image}}" mode="aspectFill" bindtap="previewImage"></image>
            <view class="image-delete" catchtap="deleteImage"><view class="image-delete-icon"><van-icon name="cross" size="24rpx" color="#fff" /></view></view>
          </view>
          <view class="image-add" wx:else bindtap="chooseImage">
            <van-icon name="plus" size="56rpx" color="#a5a8ae" />
            <text>选择图片</text>
          </view>
        </view>
      </view>

      <view class="form-section contact-section">
        <view class="section-head"><text class="section-title">联系方式</text><text class="section-note">选填</text></view>
        <input class="{{focusedInput == 'contact' ? 'focused' : ''}}" value="{{contact}}" maxlength="255" placeholder="留下联系方式，方便我们回复" placeholder-class="input-placeholder" data-field="contact" bindinput="changeContact" bindfocus="onInputFocus" bindblur="onInputBlur" />
      </view>
    </view>
  </view>

  <view class="submit-bar">
    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitFeedback">提交反馈</button>
  </view>
</view>
