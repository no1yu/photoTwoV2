page {
  height: 100vh;
  overflow: hidden;
}

.search-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

page-header {
  flex-shrink: 0;
}

.search-card {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 80rpx;
  margin: 28rpx 28rpx 20rpx;
  padding: 0 28rpx;
  border-radius: 40rpx;
  background: #fff;
}

.search-card input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin-left: 16rpx;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: #30343B;
  font-size: 28rpx;
}

.search-placeholder {
  color: #8A8E96;
}

.search-clear {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 80rpx;
  margin-right: -12rpx;
}

.container {
  flex: 1;
  height: 0;
  min-height: 0;
}

.grid-container {
  padding: 0 28rpx 16rpx;
}

.grid-item {
  display: flex;
  align-items: center;
  min-height: 138rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
}

.grid-content {
  flex: 1;
  min-width: 0;
}

.title {
  color: #30343B;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.4;
}

.description {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
}

.description text {
  flex: 1;
  min-width: 0;
}

.arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 28rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: #8A8E96;
  font-size: 28rpx;
  font-weight: 400;
}

.empty-desc {
  margin-top: 12rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.scroll-to-top {
  position: fixed;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid #E9EBEF;
  border-radius: 50%;
  background: #fff;
}

.list-status {
  padding: 8rpx 28rpx 30rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}
