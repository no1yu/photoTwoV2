<view class="my-page page-shell">
  <page-header title="个人中心" light="{{true}}" />

  <view class="profile-content">
    <view class="avatar-box" wx:if="{{!authorized}}" bindtap="goLogin">
      <image mode="aspectFill" src="{{avatarUrl}}"></image>
    </view>
    <view class="avatar-box" wx:else bindtap="openEditProfileModal">
      <image mode="aspectFill" src="{{avatarUrl}}"></image>
    </view>
    <view class="profile-info" wx:if="{{!authorized}}" bindtap="goLogin">
      <text class="name">登录 / 注册</text>
      <view class="profile-edit"><text>登录后查看我的作品</text></view>
    </view>
    <view class="profile-info" wx:else bindtap="openEditProfileModal">
      <view class="profile-name-row">
        <text class="name">{{nickname}}</text>
        <view class="profile-edit"><text>编辑资料</text></view>
      </view>
      <text class="profile-days">{{title}}已经陪伴你走过 {{days}} 天</text>
    </view>
  </view>

  <view class="rights-section">
    <view class="rights-banner" bindtap="navigateToEdit">
      <view class="rights-copy">
        <text class="rights-title">我的权益</text>
        <text class="rights-desc">了解照片下载方式</text>
      </view>
      <button class="rights-view">查看</button>
    </view>
    <view class="shortcut-bar">
      <button class="shortcut-item" bindtap="mywork">
        <view class="shortcut-icon"><van-icon name="description" size="56rpx" /></view>
        <view class="shortcut-copy"><text class="shortcut-title">我的作品</text><text class="shortcut-desc">查看制作的照片</text></view>
      </button>
      <button class="shortcut-item" open-type="contact">
        <view class="shortcut-icon"><van-icon name="service" size="56rpx" /></view>
        <view class="shortcut-copy"><text class="shortcut-title">客服中心</text><text class="shortcut-desc">遇到问题来这里</text></view>
      </button>
    </view>
  </view>

  <view class="menu-section">
    <button class="menu-row" bindtap="openHelpList">
      <view class="menu-icon"><van-icon name="question-o" size="44rpx" /></view>
      <text class="menu-title">常见问题</text>
      <van-icon name="arrow" size="28rpx" color="#B3B6BC" />
    </button>
    <button class="menu-row" bindtap="goFeedback">
      <view class="menu-icon"><van-icon name="edit" size="44rpx" /></view>
      <text class="menu-title">意见反馈</text>
      <van-icon name="arrow" size="28rpx" color="#B3B6BC" />
    </button>
    <button class="menu-row" wx:if="{{officialSwitch == 1}}" bindtap="openOfficialModal">
      <view class="menu-icon"><van-icon name="chat-o" size="44rpx" /></view>
      <text class="menu-title">关注公众号</text>
      <van-icon name="arrow" size="28rpx" color="#B3B6BC" />
    </button>
    <button class="menu-row" open-type="share">
      <view class="menu-icon"><van-icon name="share-o" size="44rpx" /></view>
      <text class="menu-title">分享小程序</text>
      <van-icon name="arrow" size="28rpx" color="#B3B6BC" />
    </button>
  </view>

  <view class="modal {{modalClosing ? 'modal-closing' : ''}}" wx:if="{{modalType === 'rights'}}" catchtouchmove="noop">
    <view class="modal-content">
      <view class="modal-body">
        <view class="modal-title">照片下载方式</view>
        <view class="modal-list">
          <text>不同功能的下载方式由管理员设置，以下载页面显示的方式为准</text>
          <text>免费下载可以直接保存，广告下载需要完整看完广告，付费下载需要先完成支付</text>
          <text>已下载的照片可以在我的作品中再次保存，成片从上传时间起保留7天，请及时保存到相册</text>
        </view>
        <button bindtap="closeModal">我知道了</button>
      </view>
    </view>
  </view>

  <view class="modal {{modalClosing ? 'modal-closing' : ''}}" wx:if="{{modalType === 'questions'}}" catchtouchmove="noop">
    <view class="modal-content">
      <view class="modal-body">
        <view class="modal-title">常见问题</view>
        <scroll-view class="help-content" style="height: {{helpHeight}}px" scroll-y="{{true}}" catchtouchmove="noop">
          <view class="help-inner">
            <text class="help-loading" wx:if="{{helpLoading}}">加载中</text>
            <block wx:else>
              <view class="help-empty" wx:if="{{!helpList.length}}">暂无常见问题</view>
              <view class="help-item" wx:for="{{helpList}}" wx:key="id">
                <text class="help-title">{{item.title}}</text>
                <text class="help-answer">{{item.content}}</text>
              </view>
            </block>
          </view>
        </scroll-view>
        <button bindtap="closeModal">我知道了</button>
      </view>
    </view>
  </view>

  <view class="sheet-modal {{modalClosing ? 'modal-closing' : ''}}" wx:if="{{modalType === 'editProfile'}}" catchtap="closeModal" catchtouchmove="noop">
    <view class="sheet-content profile-sheet" style="bottom: {{keyboardHeight}}px" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <text class="sheet-title">编辑个人资料</text>
        <view class="sheet-close" bindtap="closeModal"><van-icon name="cross" size="32rpx" color="#8A8E96" /></view>
      </view>
      <view class="modal-body">
        <view class="edit-profile-form">
          <view class="profile-field">
            <text class="profile-label">头像</text>
            <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
              <image class="avatar" src="{{avatarFile}}" mode="aspectFill"></image>
            </button>
          </view>
          <view class="nickname-field">
            <text class="nickname-label">昵称</text>
            <input type="nickname" class="nickname-input" placeholder="请输入昵称（非必填）" placeholder-class="input-placeholder" value="{{nicknameFile}}" adjust-position="{{false}}" bindinput="onNicknameInput" bindfocus="onNicknameFocus" bindblur="onNicknameBlur" bindkeyboardheightchange="onKeyboardHeightChange" />
          </view>
        </view>
        <button class="save-button" bindtap="updateUserInfo">保存</button>
      </view>
    </view>
  </view>

  <view class="sheet-modal official-modal {{modalClosing ? 'modal-closing' : ''}}" wx:if="{{modalType === 'official'}}" catchtap="closeModal" catchtouchmove="noop">
    <view class="sheet-content" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <text class="sheet-title">关注公众号</text>
        <view class="sheet-close" bindtap="closeModal"><van-icon name="cross" size="32rpx" color="#8A8E96" /></view>
      </view>
      <view class="official-qr-box">
        <view class="official-qr">
          <image wx:if="{{!officialQrFailed}}" src="{{officialQrCode}}" mode="aspectFit" show-menu-by-longpress="{{true}}" binderror="onOfficialQrError"></image>
          <view class="official-qr-error" wx:else><van-icon name="photo-o" size="72rpx" color="#8A8E96" /><text>二维码获取失败</text></view>
        </view>
        <text class="official-qr-tip" wx:if="{{!officialQrFailed}}">长按识别二维码关注公众号</text>
        <button class="official-save-button" wx:if="{{!officialQrFailed}}" bindtap="saveOfficialQrCode">保存二维码</button>
      </view>
    </view>
  </view>
</view>
