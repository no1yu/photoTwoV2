.my-page {
  min-height: 100vh;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  background: #F5F6F8;
}

.profile-content {
  display: flex;
  align-items: center;
  margin: 28rpx 28rpx 32rpx;
  min-height: 136rpx;
  color: #30343B;
}

.avatar-box {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  margin-right: 24rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #E7E9ED;
}

.avatar-box image {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-name-row .name {
  flex: 1;
  min-width: 0;
}

.profile-name-row .profile-edit {
  flex-shrink: 0;
  margin-top: 0;
  white-space: nowrap;
}

.name {
  display: block;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-edit {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
}

.profile-days {
  display: block;
  margin-top: 12rpx;
  color: #8A8E96;
  font-size: 24rpx;
  line-height: 1.5;
}

.rights-section {
  margin: 0 28rpx 24rpx;
}

.rights-banner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 180rpx;
  padding: 28rpx 28rpx 48rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #3D68ED;
  color: #fff;
}

.rights-copy {
  position: relative;
  flex: 1;
  min-width: 0;
  z-index: 1;
}

.rights-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
}

.rights-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 26rpx;
  line-height: 1.4;
}

.rights-view {
  position: relative;
  flex-shrink: 0;
  z-index: 1;
  width: 116rpx;
  height: 56rpx;
  margin: 0 0 0 20rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #3D68ED;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.shortcut-bar {
  position: relative;
  display: flex;
  margin-top: -24rpx;
  padding: 28rpx 18rpx;
  border-radius: 20rpx;
  background: #fff;
}

.shortcut-item {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  margin: 0;
  padding: 4rpx 14rpx;
  text-align: left;
}

.shortcut-item + .shortcut-item {
  border-left: 1rpx solid #F0F1F3;
}

.shortcut-icon {
  flex-shrink: 0;
  margin-right: 14rpx;
  color: #3D68ED;
  line-height: 1;
}

.shortcut-copy {
  flex: 1;
  min-width: 0;
}

.shortcut-title {
  display: block;
  color: #30343B;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.4;
}

.shortcut-desc {
  display: block;
  margin-top: 6rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
  white-space: normal;
}

.menu-section {
  margin: 0 28rpx;
  padding: 8rpx 28rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
}

.menu-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 108rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: #fff;
  text-align: left;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  margin-right: 24rpx;
  color: #30343B;
  line-height: 1;
}

.menu-title {
  flex: 1;
  color: #30343B;
  font-size: 32rpx;
  line-height: 1.5;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(18, 35, 66, 0.4);
  animation: mine-mask-in 200ms ease-out both;
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  padding: 36rpx;
  border-radius: 20rpx;
  background: #fff;
  animation: mine-dialog-in 240ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.modal-title {
  margin-bottom: 26rpx;
  color: #30343B;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
}

.modal-list text {
  display: block;
  margin-bottom: 18rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.6;
}

.modal-body > button,
.save-button,
.official-save-button {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 44rpx;
  background: #3D68ED;
  color: #fff;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 88rpx;
}

.help-empty {
  padding: 56rpx 0;
  color: #8A8E96;
  font-size: 26rpx;
  text-align: center;
}

.help-item + .help-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F1F3;
}

.help-title {
  display: block;
  margin-bottom: 10rpx;
  color: #30343B;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

.help-answer,
.help-loading {
  display: block;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.6;
}

.sheet-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 35, 66, 0.4);
  animation: mine-mask-in 200ms ease-out both;
}

.sheet-content {
  width: 100%;
  padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  animation: mine-sheet-in 240ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.profile-sheet {
  position: absolute;
  left: 0;
}

.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 8rpx;
  background: #E5E7EB;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-title {
  color: #30343B;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.4;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.edit-profile-form {
  padding: 0 4rpx;
}

.profile-field,
.nickname-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
}

.profile-field {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.profile-label,
.nickname-label {
  flex-shrink: 0;
  margin-right: 28rpx;
  color: #30343B;
  font-size: 30rpx;
  line-height: 1.5;
}

.avatar-wrapper {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  border-radius: 50%;
  background: #E7E9ED;
}

.avatar-wrapper .avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nickname-input {
  flex: 1;
  min-width: 0;
  width: auto;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #30343B;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: right;
}

.input-placeholder {
  color: #8A8E96;
}

.official-qr-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.official-qr {
  width: 320rpx;
  height: 320rpx;
  background: #fff;
}

.official-qr image {
  width: 100%;
  height: 100%;
}

.official-qr-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  height: 100%;
  border-radius: 12rpx;
  background: #F5F6F8;
  color: #8A8E96;
  font-size: 26rpx;
}

.official-qr-tip {
  margin-top: 20rpx;
  color: #8A8E96;
  font-size: 26rpx;
  line-height: 1.5;
}

.modal-closing {
  animation: mine-mask-out 200ms ease-in both;
}

.modal-closing .modal-content {
  animation: mine-dialog-out 200ms ease-in both;
}

.modal-closing .sheet-content {
  animation: mine-sheet-out 200ms ease-in both;
}

@keyframes mine-mask-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes mine-dialog-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes mine-sheet-in {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

@keyframes mine-mask-out {
  from {
    opacity: 1;
  }

  to {
    opacity: 0;
  }
}

@keyframes mine-dialog-out {
  from {
    opacity: 1;
    transform: translateY(0);
  }

  to {
    opacity: 0;
    transform: translateY(12rpx);
  }
}

@keyframes mine-sheet-out {
  from {
    transform: translateY(0);
  }

  to {
    transform: translateY(100%);
  }
}
